.button {
    font-size: 20px;
    -unity-font-style: bold;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background-color: rgba(67, 245, 0, 0.8);
}

.button:active {
    background-color: rgba(67, 174, 0, 0.6);
    bottom: -2px;
    right: -2px;
}

.button:hover {
    background-color: rgb(67, 245, 0);
}

.button:disabled {
    background-color: var(--unity-colors-button-background-disabled);
}
