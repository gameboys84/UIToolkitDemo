<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="MainPage" src="project://database/Assets/Toolbar/UI/UIAnimation/MainPage.uxml?fileID=9197481963319205126&amp;guid=5134ababe0e95324e8745fb72ec46c61&amp;type=3#MainPage" />
    <ui:Template name="Menu" src="project://database/Assets/Toolbar/UI/UIAnimation/Menu.uxml?fileID=9197481963319205126&amp;guid=2e57e752b271e3746a39ee2bda4945bc&amp;type=3#Menu" />
    <Style src="project://database/Assets/Toolbar/UI/UIAnimation/UIAnimation.uss?fileID=7433441132597879392&amp;guid=0ecc8ec288588cd4299038970cd7165d&amp;type=3#UIAnimation" />
    <ui:VisualElement name="BaseContainer" class="background" style="flex-grow: 1;">
        <ui:VisualElement name="StatusBar" class="status-bar" style="flex-grow: 1;">
            <ui:Label tabindex="-1" text="11:11 am." parse-escape-sequences="true" display-tooltip-when-elided="true" name="StatusBarText" class="text" />
            <ui:VisualElement name="Spacer" style="flex-grow: 1;" />
            <ui:VisualElement name="StatusBarIconsContainer" style="flex-grow: 1; flex-direction: row;">
                <ui:VisualElement name="StatusBarIcon" class="status-bar__icons" style="flex-grow: 1;" />
                <ui:VisualElement name="StatusBarIcon" class="status-bar__icons status-bar__icons-highlighted" style="flex-grow: 1;" />
                <ui:VisualElement name="StatusBarIcon" class="status-bar__icons" style="flex-grow: 1;" />
                <ui:VisualElement name="StatusBarIcon" class="status-bar__icons" style="flex-grow: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="≡" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ToggleMenu" class="button" style="width: 80px; align-self: flex-end; font-size: 55px; margin-top: 26px; margin-right: 26px; margin-bottom: 0; margin-left: 26px;" />
        <ui:VisualElement name="AppContent" style="flex-grow: 1;">
            <ui:Instance template="MainPage" name="MainPage" />
            <ui:Instance template="Menu" name="MenuContainer" usage-hints="GroupTransform" class="menu-container" style="position: absolute; flex-grow: 1; width: 100%; height: 100%;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
