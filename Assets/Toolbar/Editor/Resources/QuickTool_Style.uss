VisualElement {}

.buttons-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.quicktool-button {
    /* Sets the size of the button. */
    width: 50px;
    height: 50px;
    
    align-items: flex-start;
    justify-content: center;
}

.quicktool-button-icon {
    /* Sets the size of the icon inside the button. */
    width: 40px;
    height: 40px;
    opacity: 0.8;
}

.quicktool-button-icon:hover {
    opacity: 1;
}

.quicktool-button:active > .quicktool-button-icon {
    opacity: 0.6;
}